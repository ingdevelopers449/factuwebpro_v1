  <diagram id="d7yEum7YC-a0YTQURsFy" name="Página-1">
    <mxGraphModel dx="5150" dy="3610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Categoria {\n        -conn : mysqli\n        +__construct()\n        +obtenerTodas() array\n        +obtenerActivas() array\n        +obtenerPorId(id_categoria int) array\n        +existeNombre(nombre string, id_excluir int) bool\n        +insertar(nombre_categoria string, descripcion string, estado string, fecha_creacion string, fecha_actualizacion string) int\n        +actualizar(id_categoria int, nombre_categoria string, descripcion string, estado string, fecha_creacion string, fecha_actualizacion string) bool\n        +cambiarEstado(id_categoria int, nuevo_estado string, fecha_actualizacion string) bool\n    }\n\n    class Cliente {\n        -conn : mysqli\n        +__construct()\n        +obtenerTodos() array\n        +buscar(termino) array\n        +obtenerPorIdentificacion(identificacion, exclude_id) array\n        +obtenerPorId(id_cliente) array\n        +insertar(identificacion, nombre_razon_social, email, direccion, telefono) bool\n        +actualizar(id_cliente, identificacion, nombre_razon_social, email, direccion, telefono) bool\n        +eliminar(id_cliente) bool\n    }\n\n    class Empresa {\n        -conn : mysqli\n        +__construct()\n        +obtenerTodos() array\n        +insertar(nit, razon_social, direccion, telefono, correo, logo) bool\n        +actualizar(nit, razon_social, direccion, telefono, correo, logo) bool\n    }\n\n    class Factura {\n        -conn : mysqli\n        +__construct()\n        +obtenerSiguienteNumero(id_empresa int) array\n        +crearFactura(id_empresa int, id_cliente int, id_usuario int, subtotal float, total_iva float, total_pagar float, detalles array) array\n        +obtenerFacturaPorId(id_factura int) array\n        +obtenerDetallesFactura(id_factura int) array\n        +contarVentasPorUsuario(id_usuario int, fecha_inicio string, fecha_fin string) int\n        +totalVentasPorUsuario(id_usuario int, fecha_inicio string, fecha_fin string) float\n        +obtenerVentasPorUsuario(id_usuario int, fecha_inicio string, fecha_fin string, pagina int, por_pagina int) array\n    }\n\n    class Producto {\n        -conn : mysqli\n        +__construct()\n        +obtenerTodos(limit int, offset int) array\n        +contarTodos() int\n        +buscar(termino string, limit int, offset int) array\n        +contarBuscar(termino string) int\n        +existeCodigo(codigo_barras string, id_excluir int) bool\n        +insertar(codigo_barras string, nombre_producto string, precio_compra float, precio_venta float, stock_actual int, tarifa_iva float, estado_producto string, id_categoria int, imagen_url string) bool\n        +actualizar(id_producto int, codigo_barras string, nombre_producto string, precio_compra float, precio_venta float, stock_actual int, tarifa_iva float, estado_producto string, id_categoria int, imagen_url string) bool\n        +alternarEstado(id_producto int, nuevo_estado string) bool\n    }\n\n    class Rentabilidad {\n        -conn : mysqli\n        +__construct()\n        +obtenerConsolidado(fecha_inicio string, fecha_fin string) array\n        +obtenerPorCategoria(fecha_inicio string, fecha_fin string) array\n        +obtenerHistorialGlobal(fecha_inicio string, fecha_fin string) array\n        +obtenerDetalleUtilidad(id_factura int) array\n    }\n\n    class ResolucionDian {\n        -conn : mysqli\n        +__construct()\n        +obtenerTodos() array\n        +insertar(id_empresa, numero_resolucion, fecha_vigencia, prefijo, rango_inicial, rango_final, contador_actual, estado) bool\n        +actualizar(id_empresa, numero_resolucion, fecha_vigencia, prefijo, rango_inicial, rango_final, contador_actual, estado) bool\n    }\n\n    class Rol {\n        -conn : mysqli\n        +__construct()\n        +obtenerTodos() array\n    }\n\n    class Usuario {\n        -conn : mysqli\n        +__construct()\n        +registrar(id_empresa int, nombre string, email string, password string, id_rol int, estado string, porcentaje_comision float) bool\n        +emailExiste(email string) bool\n        +obtenerPorEmail(email string) array\n        +registrarIntentoFallido(id_usuario int, intentos_actuales int) bool\n        +guardarTokenRecuperacion(email string, token string, expiracion string) bool\n        +obtenerPorToken(token string) array\n        +actualizarPassword(id_usuario int, nueva_password string) bool\n        +resetearIntentosYActualizarAcceso(id_usuario int) void\n        +obtenerTodos() array\n        +obtenerEstados() array\n        +actualizar(id_usuario int, datos array) bool\n        +eliminar(id_usuario int) bool\n    }\n\n    class VentaBorrador {\n        -conn : mysqli\n        +__construct()\n        +obtenerBorrador(id_usuario int) array\n        +guardarBorrador(id_usuario int, id_cliente int, detalles array) bool\n        +limpiarBorrador(id_usuario int) bool\n    }\n\n    class DetalleFactura {\n        &lt;&lt;tabla gestionada por Factura&gt;&gt;\n        id_detalle : int\n        id_factura : int\n        id_producto : int\n        cantidad : int\n        precio_unitario_venta : float\n        precio_unitario_costo : float\n        subtotal_linea : float\n    }\n\n    class DetalleBorrador {\n        &lt;&lt;tabla gestionada por VentaBorrador&gt;&gt;\n        id_detalle_borrador : int\n        id_borrador : int\n        id_producto : int\n        cantidad : int\n    }\n\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Factura : id_usuario\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..1\&quot; VentaBorrador : id_usuario (UNIQUE)\n\n    Empresa \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Usuario : id_empresa\n    Empresa \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Factura : id_empresa\n    Empresa \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ResolucionDian : id_empresa\n\n    Rol \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Usuario : id_rol\n\n    Cliente \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Factura : id_cliente (NULL = Consumidor Final)\n    Cliente \&quot;1\&quot; --&gt; \&quot;0..1\&quot; VentaBorrador : id_cliente\n\n    Categoria \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Producto : id_categoria\n\n    Producto \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DetalleFactura : id_producto\n    Producto \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DetalleBorrador : id_producto\n\n    Factura \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DetalleFactura : id_factura (CASCADE)\n\n    ResolucionDian \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Factura : id_resolucion\n\n    VentaBorrador \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DetalleBorrador : id_borrador (CASCADE)\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="154">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
